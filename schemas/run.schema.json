{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Outcome QA run record version 1",
  "description": "A declared QA run with local artifact references. Structural validity does not prove product behavior. qa_result.py additionally verifies IDs, references, artifact containment, regular-file status and SHA-256 integrity and derives a conservative summary.",
  "$comment": "The Python validator is authoritative for operational checks not expressible by this schema. In particular it requires version to be represented as the JSON integer 1, not 1.0. No input verdict is accepted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "run_id",
    "target",
    "scope",
    "checks",
    "artifacts",
    "cleanup"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "run_id": {
      "$ref": "#/$defs/identifier"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "build",
        "actor"
      ],
      "properties": {
        "environment": {
          "$ref": "#/$defs/text"
        },
        "build": {
          "anyOf": [
            {
              "$ref": "#/$defs/text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Null means unverified build attribution; observations remain usable without claiming a deployed fix."
        },
        "actor": {
          "$ref": "#/$defs/text",
          "description": "Use a nonsecret role or synthetic actor label, never a credential."
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal",
        "basis",
        "exclusions"
      ],
      "properties": {
        "goal": {
          "$ref": "#/$defs/text"
        },
        "basis": {
          "$ref": "#/$defs/text"
        },
        "exclusions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "required_check_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "description": "Optional agreed check inventory. Any required ID missing from checks makes the run incomplete. The helper cannot prove inventory completeness against an external spec."
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "notes"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_needed",
            "verified",
            "pending",
            "failed"
          ]
        },
        "notes": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "superseded_by": {
      "$ref": "#/$defs/text",
      "description": "Replacement record ID or reference. A superseded record cannot support a current PASS. This reference is informational and is never fetched."
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "expectation",
        "basis",
        "status",
        "evidence_refs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "expectation": {
          "$ref": "#/$defs/text"
        },
        "basis": {
          "$ref": "#/$defs/text"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED",
            "INCONCLUSIVE",
            "NOT_RUN"
          ]
        },
        "observation": {
          "$ref": "#/$defs/text"
        },
        "reason": {
          "$ref": "#/$defs/text"
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "reproducibility": {
          "enum": [
            "single_observation",
            "replayed",
            "not_applicable"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "PASS",
                  "FAIL"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "observation"
            ],
            "properties": {
              "evidence_refs": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "BLOCKED",
                  "INCONCLUSIVE",
                  "NOT_RUN"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "sha256"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "allOf": [
            {
              "pattern": "\\S"
            },
            {
              "pattern": "^[^:/\\\\]+(?:/[^:/\\\\]+)*$"
            },
            {
              "not": {
                "pattern": "(?:^|/)\\.{1,2}(?:/|$)"
              }
            }
          ],
          "description": "POSIX-style file path relative to the report directory. No absolute paths, colon, backslash, empty/dot/parent segments or symlinks. Referenced file must exist and be regular."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?=.*\\S)[^\u0000-\u001f\u007f-\u009f\u00ad\u0600-\u0605\u061c\u06dd\u070f\u0890-\u0891\u08e2\u180e\u200b-\u200f\u2028-\u202e\u2060-\u2064\u2066-\u206f\ud800-\uf8ff\ufeff\ufff9-\ufffb\ud804\udcbd\ud804\udccd\ud80d\udc30-\ud80d\udc3f\ud82f\udca0-\ud82f\udca3\ud834\udd73-\ud834\udd7a\udb40\udc01\udb40\udc20-\udb40\udc7f\udb80\udc00-\udbbf\udffd\udbc0\udc00-\udbff\udffd]+(?![\\s\\S])",
      "description": "Nonblank identifier without fixed control/format, separator, surrogate or private-use ranges; identical to helper regexp."
    }
  }
}
